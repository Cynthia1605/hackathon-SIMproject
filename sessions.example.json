{
  "version": 1,
  "output_root": "outputs",
  "cache_dir": "cache",
  "model_path": "models/pose_landmarker_heavy.task",
  "defaults": {
    "sync": {
      "clap_threshold_sw": 0.35,
      "min_closing_speed_sw_per_s": 3.0,
      "audio_highpass_hz": 2500,
      "audio_confirm_tolerance_frames": 1,
      "motion_xcorr_max_lag_s": 10.0
    },
    "music": {"bandpass_hz": [60, 250]},
    "segmenter": {"window_s": 1.5, "hop_s": 0.25, "merge_gap_s": 1.2, "min_epoch_s": 2.5},
    "calibration": {
      "visibility_min": 0.85,
      "focal_factor": 0.85,
      "height_eye_ratio": 0.935,
      "span_percentile": 95
    }
  },
  "sessions": [
    {
      "id": "subject_01",
      "cam1": "data/subject_01/cam1.mp4",
      "cam2": "data/subject_01/cam2.mp4",
      "song_mp3": "data/subject_01/song.mp3",
      "height_meters": 1.68,
      "overrides": {"frame_offset": null, "mp3_offset_sec": null},
      "params": {}
    },
    {
      "id": "subject_02",
      "cam1": "data/subject_02/cam1.mp4",
      "cam2": "data/subject_02/cam2.mp4",
      "song_mp3": "data/subject_02/song.mp3",
      "height_meters": 1.75,
      "overrides": {"frame_offset": null, "mp3_offset_sec": null},
      "params": {}
    }
  ]
}
