{
  "version": 1,
  "output_root": "outputs",
  "cache_dir": "cache",
  "model_path": "models/pose_landmarker_heavy.task",
  "defaults": {
    "sync": {
      "clap_threshold_sw": 0.35,
      "min_closing_speed_sw_per_s": 3.0,
      "audio_highpass_hz": 2500,
      "audio_confirm_tolerance_frames": 1,
      "motion_xcorr_max_lag_s": 10.0
    },
    "music": {
      "bandpass_hz": [
        60,
        250
      ],
      "sr": 22050,
      "hop_length": 512,
      "max_offset_s": null
    },
    "segmenter": {
      "window_s": 1.5,
      "hop_s": 0.25,
      "merge_gap_s": 1.2,
      "min_epoch_s": 2.5,
      "range_ref_m": 0.1,
      "lift_ref_m": 0.02,
      "alt_ref_mps": 0.15,
      "walk_travel_m": 0.8,
      "start_frac": 0.4,
      "stop_frac": 0.2,
      "min_start_energy": 1.5,
      "min_stop_energy": 0.8,
      "motion_speed_mps": 0.15
    },
    "calibration": {
      "visibility_min": 0.85,
      "focal_factor": 0.85,
      "height_eye_ratio": 0.935,
      "span_percentile": 95,
      "triangulation_visibility_min": 0.5,
      "floor_percentile": 20,
      "max_fundamental_points": 20000,
      "ransac_threshold_px": 3.0,
      "ransac_confidence": 0.99
