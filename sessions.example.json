      "min_step_interval_s": 0.15,
      "still_speed_mps": 0.08,
      "still_speed_frac": 0.3,
      "slow_ratio": 1.5,
      "speed_smooth_frames": 3,
      "count_one_foot": "auto"
    }
  },
  "sessions": [
    {
      "id": "subject_01",
      "cam1": "data/subject_01/cam1.mp4",
      "cam2": "data/subject_01/cam2.mp4",
      "song_mp3": "data/subject_01/song.mp3",
      "height_meters": 1.68,
      "overrides": {
        "frame_offset": null,
        "mp3_offset_sec": null
      },
      "params": {}
    },
    {
      "id": "subject_02",
      "cam1": "data/subject_02/cam1.mp4",
      "cam2": "data/subject_02/cam2.mp4",
      "song_mp3": "data/subject_02/song.mp3",
      "height_meters": 1.75,
      "overrides": {
        "frame_offset": null,
        "mp3_offset_sec": null
      },
      "params": {}
    }
  ]
